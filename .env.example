# Copy to .env.local. These values override any existing .env.
VITE_DEMO_MODE=true
# Empty = same-origin API through the local development/preview proxy.
VITE_API_BASE=
VITE_API_PROXY_TARGET=http://localhost:8000
# PWA is generated for build/preview; the dev server never installs it.
VITE_PWA_ENABLED=true
VITE_SITE_PASSWORD=
